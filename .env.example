# CONTACT FORM
# Copy this example file to a fresh .env file and enter your mail info here to connect the contact form.
NODEMAILER_LOGIN=your-gmail@example.com
NODEMAILER_PW=your-gmail-app-password
FORWARD_MAIL_TO=recipient@example.com

# META PIXEL (Facebook / Instagram ads)
# Only used on /lessons. Leave blank to disable.
# Get the ID from Meta Events Manager → Data sources → your Pixel → Settings → Pixel ID
PUBLIC_META_PIXEL_ID=
