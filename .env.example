# CONTACT FORM
# Copy this example file to a fresh .env file and enter your mail info here to connect the contact form.
NODEMAILER_LOGIN=your-gmail@example.com
NODEMAILER_PW=your-gmail-app-password
FORWARD_MAIL_TO=recipient@example.com

# META PIXEL (Facebook / Instagram ads)
# Only used on /lessons. Leave blank to disable.
# Get the ID from Meta Events Manager → Data sources → your Pixel → Settings → Pixel ID
PUBLIC_META_PIXEL_ID=

# META CONVERSIONS API (server-side Lead events, immune to ad blockers)
# Events Manager → your dataset → Settings → Conversions API → Generate access token.
# Requires PUBLIC_META_PIXEL_ID above. Leave blank to disable.
META_CAPI_ACCESS_TOKEN=
# Optional. Paste the code from Events Manager → Test Events to see server events
# there in real time. Remove it when you are done testing.
META_CAPI_TEST_EVENT_CODE=
